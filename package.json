{
  "name": "doc-extract-bench",
  "version": "0.1.0",
  "description": "Reproducible benchmark of document-extraction APIs (invoices, receipts, bank statements, tables): Kynth Core vs AWS Textract, Google Document AI, Veryfi, LlamaParse.",
  "license": "MIT",
  "author": "Isaiah Kim <kyisaiah47@gmail.com>",
  "repository": "github:kyisaiah47/doc-extract-bench",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "fetch": "tsx scripts/fetch.ts",
    "select": "tsx datasets/select.ts",
    "run": "tsx src/run.ts",
    "replay": "tsx src/run.ts --replay",
    "report": "tsx src/report.ts",
    "test": "tsx --test src/score/*.test.ts",
    "verify-manifest": "tsx scripts/fetch.ts --verify"
  },
  "dependencies": {
    "@aws-sdk/client-textract": "^3.700.0",
    "@aws-sdk/credential-providers": "^3.700.0",
    "hyparquet": "^1.8.0",
    "hyparquet-compressors": "^1.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@aws-sdk/client-sts": "^3.1084.0",
    "@types/node": "^22.0.0",
    "@types/unzipper": "^0.10.11"
  }
}
